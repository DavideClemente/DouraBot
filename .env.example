# Copy to `.env` and fill in real values. `.env` is gitignored and is the
# single source of truth for runtime config — injected via docker-compose
# `env_file`. Nothing here is baked into the Docker image.

# --- Runtime environment ---
ENVIRONMENT=PROD          # PROD or DEV

# --- Discord ---
TOKEN_PROD=               # Discord bot token (production)
TOKEN_DEV=                # Discord bot token (dev), only needed when ENVIRONMENT=DEV
DOURADINHOS=             # Discord guild ID

# --- External APIs ---
CURRENCY_API_KEY=
CLOUDFLARE_WORKER=        # IMDB worker URL
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
FACEIT_API_KEY=
AIRPORTS_DB_KEY=
UPTIME_KUMA_URL=          # e.g. http://uptime-kuma:3001/api/push/<token>?status=up&msg=OK&ping=

# --- Bot -> MariaDB connection (consumed by src/settings.py) ---
DB_HOST=mariadoura        # service name on the compose network; use localhost for local dev
DB_PORT=3306
DB_USER=root
DB_PASSWORD=changeme
DB_DATABASE=master

# --- MariaDB container bootstrap (consumed by the mariadb image) ---
MARIADB_ROOT_PASSWORD=changeme   # must match DB_PASSWORD when DB_USER=root
MARIADB_DATABASE=master
MARIADB_USER=dourabot
MARIADB_PASSWORD=dourabot123
